        {
            "Name": "Great_Hunts",
            "PackageID": 3315290,
            "DLCName": "NSLOCTEXT(\"D_DLCPackageData\", \"Great_Hunts-DLCName\", \"Great Hunts\")",
            "WebsiteAddress": "steam://url/StoreAppPage/3315290/Icarus_Great_Hunts_Campaigns/?utm_source=GameClient&utm_campaign=InGameButton&utm_content=MainMenu",
            "Icon": "/Game/Assets/2DArt/UI/Icons/FeatureLevel/T_FeatureLevel_GH.T_FeatureLevel_GH",
            "HoverText": "NSLOCTEXT(\"D_DLCPackageData\", \"Great_Hunts-HoverText\", \"Nonlinear boss-hunting campaigns spanning three ICARUS maps, where your choices shape every hunt - affecting spawns, loot, recipes, and boss difficulty. Track each boss to their hidden arena, take them down, and forge Legendary Weapons from their drops, each with 81 unique upgrade combinations. Three hunts at launch, with more to come.\\r\\n\\r\\n> 3 campaigns at launch, one per map (Olympus, Styx, Prometheus)\\r\\n> New World Bosses with unique powers and hidden arenas\\r\\n> Legendary Weapons with 4 upgrade slots and 81 unique combinations per weapon\\r\\n> Branching missions with mutually exclusive choices\\r\\n> New weapons, tools, armour, traps, modules, and attachments\")",
            "DLCIconOwned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICONS_GreatHunts.T_ICONS_GreatHunts",
