            "Name": "Pet_Companions",
            "PackageID": 2923820,
            "DLCName": "NSLOCTEXT(\"D_DLCPackageData\", \"Pet_Companions-DLCName\", \"Pet Companions\")",
            "WebsiteAddress": "steam://url/StoreAppPage/2923820/Icarus_Pet_Companions_Pack/?utm_source=GameClient&utm_campaign=InGameButton&utm_content=MainMenu",
            "Icon": "/Game/Assets/2DArt/UI/Icons/T_ICON_Paws.T_ICON_Paws",
            "HoverText": "NSLOCTEXT(\"D_DLCPackageData\", \"Pet_Companions-HoverText\", \"The Laika update brings animal companions to ICARUS - creatures with their own levels, talent trees, and food requirements. This pack expands your roster with 15 new animals: five cats, seven dogs, and three horses, each with unique loot and trophies. Deploy them from the Workshop and they\\'re yours for keeps.\\r\\n\\r\\n> 5 new cats: Tortoiseshell Ragdoll, Himalayan Seal Point, Grey Tabby, Orange Tabby, Black Cat\\r\\n> 7 new dogs: Golden Labrador, Chocolate Labrador, German Shepherd, Pug, Panda German Shepherd, French Bulldog, Border Collie\\r\\n> 3 new horses: Brown, Black, White\")",
