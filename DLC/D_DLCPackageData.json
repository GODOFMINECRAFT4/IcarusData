        {
            "Name": "Homestead",
            "PackageID": 2791000,
            "DLCName": "NSLOCTEXT(\"D_DLCPackageData\", \"Homestead-DLCName\", \"Homestead Decorations Pack\")",
            "WebsiteAddress": "steam://url/StoreAppPage/2791000/Icarus_Homestead_Content_Pack/?utm_source=GameClient&utm_campaign=InGameButton&utm_content=MainMenu",
            "Icon": "/Game/Assets/2DArt/UI/Icons/T_Icon_Homestead.T_Icon_Homestead",
            "HoverText": "NSLOCTEXT(\"D_DLCPackageData\", \"Homestead-HoverText\", \"50+ new furniture items, lighting, building pieces, and decorations built for prospectors who want their claim to feel like a real home. From Brick Fireplaces and fat-powered Lamp Posts to Butter Churns, a Cuckoo Clock, and a working Weather Vane - the details that turn a base into a homestead.\\r\\n\\r\\n> 50+ new furniture items and variants\\r\\n> New lighting: Lamp Posts, Wall Candles, Homestead Lantern\\r\\n> New building pieces: Shutters (2 variants), Curtains (6 variants), Saloon Doors (2 variants)\\r\\n> New utility: Planter Boxes, Scarecrow (spawn blocker), Pitchfork\\r\\n> New exterior decor: Iron & Gold Birdbaths, Weather Vane\")",
            "DLCIconOwned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICONS_Homestead.T_ICONS_Homestead",
