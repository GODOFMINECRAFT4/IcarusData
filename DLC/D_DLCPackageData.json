        {
            "Name": "New_Frontiers",
            "PackageID": 1648532,
            "DLCName": "NSLOCTEXT(\"D_DLCPackageData\", \"New_Frontiers-DLCName\", \"New Frontiers Expansion\")",
            "WebsiteAddress": "steam://url/StoreAppPage/1648532/Icarus_New_Frontiers/?utm_source=GameClient&utm_campaign=InGameButton&utm_content=MainMenu",
            "Icon": "/Game/Assets/2DArt/UI/Icons/T_FeatureLevelIcon_NewFrontiers3.T_FeatureLevelIcon_NewFrontiers3",
            "HoverText": "NSLOCTEXT(\"D_DLCPackageData\", \"New_Frontiers-HoverText\", \"Beyond Icarus\\' safe terraformed zones lies Prometheus - a region where the process failed, and everything it touched was mutated. Trek across alien grasslands, traverse volcanic wasteland laced with flowing lava, and chase a mysterious whistleblower through a chain of narrative missions that take you deeper into the unknown with every step.\\r\\n\\r\\n> 30+ new Workshop items, 100+ new craftable items\\r\\n> A new 64 km2 map made from new biomes: Volcanic, Swamp, Alien Grassland, Tundra, and the unexplored Null Sector\\r\\n> 6 new chained narrative missions\\r\\n> New creatures: Needlers, Dracs, Dreadwings and more\\r\\n> 5 new raw resources: Obsidian, Clay, Scoria, Crystallized Miasma, Super Cooled Ice\\r\\n\")",
            "DLCIconOwned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICON_DLC_NewFrontiers.T_ICON_DLC_NewFrontiers",
            "DLCIconUnowned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICON_DLC_NewFrontiers_Unavailable.T_ICON_DLC_NewFrontiers_Unavailable",
            "CapsuleImage": "/Game/Assets/2DArt/UI/DLC/T_DLC_Capsule_NewFrontiers_V.T_DLC_Capsule_NewFrontiers_V"
        },
        {
            "Name": "Dangerous_Horizons",
            "PackageID": 1648533,
            "DLCName": "NSLOCTEXT(\"D_DLCPackageData\", \"Dangerous_Horizons-DLCName\", \"Dangerous Horizons\")",
            "WebsiteAddress": "steam://url/StoreAppPage/1648533/Icarus_Dangerous_Horizons_Expansion/?utm_source=GameClient&utm_campaign=InGameButton&utm_content=MainMenu",
            "Icon": "/Game/Assets/2DArt/UI/Icons/T_ICON_Money_Symbol_Double.T_ICON_Money_Symbol_Double",
            "HoverText": "NSLOCTEXT(\"D_DLCPackageData\", \"Dangerous_Horizons-HoverText\", \"At the ground zero of Icarus\\' terraforming experiments sits Elysium, where the UDA\\'s silence hides more than radiation. Explore hostile radiation zones, encounter mutated wildlife, and settle into Eden, the first populated mission hub, as the story from New Frontiers pulls you deeper into the unknown.\\r\\n\\r\\n> A new 64 km2 map: Elysium, with new Geothermal, Radioactive biomes\\r\\n> 35+ new creatures and hostile NPCs make every biome feel new and different\\r\\n> 4 new mounts, including raptors, and 3 other new tameable creatures\\r\\n> New resources to support Tier 5 tech: Oil, Lithium, Ruby, Limestone, Uranium\\r\\n> 5 new crop species with dozens of new food recipes\")",
            "DLCIconOwned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICONS_DangerousHorizons.T_ICONS_DangerousHorizons",
            "DLCIconUnowned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICONS_DangerousHorizons_Unavailable.T_ICONS_DangerousHorizons_Unavailable",
            "CapsuleImage": "/Game/Assets/2DArt/UI/DLC/T_DLC_Capsule_DangerousHorizons_V.T_DLC_Capsule_DangerousHorizons_V"
        },
        {
            "Name": "Styx_Map",
            "PackageID": 1995690,
            "DLCName": "NSLOCTEXT(\"D_DLCPackageData\", \"Styx_Map-DLCName\", \"Styx Expansion\")",
            "WebsiteAddress": "steam://url/StoreAppPage/1995690/Icarus_Styx_Expansion/?utm_source=GameClient&utm_campaign=InGameButton&utm_content=MainMenu",
            "Icon": "/Game/Assets/2DArt/UI/Icons/T_ICON_Money_Symbol_Double.T_ICON_Money_Symbol_Double",
            "HoverText": "NSLOCTEXT(\"D_DLCPackageData\", \"Styx_Map-HoverText\", \"The Lagos Unit has declared the Styx region open for prospecting - no explanation given for why it was locked down, and none for the rumours of mutations in the local wildlife. A vast map of forested, arid, and arctic biomes awaits, centred on a braided river system that\\'s home to Crocodiles, Komodo Dragons, and Kea Parrots. Missions reshape the map as you complete them, opening new routes through terrain that never runs straight.\\r\\n\\r\\n> A new 64 km2 map with forested, arid, and arctic biomes\\r\\n> 23 new timed missions, 19 Open World Operations, 50+ SMPL3 missions\\r\\n> New creatures: Crocodiles, Komodo Dragons, Kea Parrots\\r\\n> Missions that physically alter the map and unlock new traversal routes\")",
            "DLCIconOwned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICON_DLC_Styx.T_ICON_DLC_Styx",
            "DLCIconUnowned": "/Game/Assets/2DArt/UI/DLCBadges/T_ICON_DLC_Styx_Unavailable.T_ICON_DLC_Styx_Unavailable",
